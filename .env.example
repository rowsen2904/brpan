# Domain pointed to this server (A record). Required for TLS, Outline keys, XHTTP and Trojan.
DOMAIN=vpn.example.com
# Address clients connect to in keys. Defaults to the domain; set to a bare IP for IP-only setups.
SERVER_ADDRESS=
# Enable the OpenVPN core on first start (more detectable by DPI). Toggle later in the panel.
OPENVPN_ENABLED=false
# Egress IP family. Auto-detected (global IPv6 only). Set false to force IPv4-only egress
# if the server has no working IPv6 (fixes sites not opening), or true to force dual-stack.
# FORCE_IPV6=false
# Initial admin credentials (used only on first start)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-please
# Internal panel port, bound to 127.0.0.1 and proxied by Caddy
PORT=3000
# Caddy HTTPS port for panel/subscriptions when Reality does not own 443
CADDY_HTTPS_PORT=8443
# Traffic stats polling interval, seconds
STATS_INTERVAL=15
# Log visited domains (SNI) per user into the database. Privacy-invasive.
# Seeds the panel toggle on first start; change it later in Settings.
CONNECTION_LOG=false
